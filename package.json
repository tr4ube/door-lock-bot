{
  "name": "door-lock-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:locked": "tsx scripts/mock-locked.ts",
    "mock:unlocked": "tsx scripts/mock-unlocked.ts",
    "mock:heartbeat": "tsx scripts/mock-heartbeat.ts",
    "firmware:setup:wsl": "bash scripts/setup-platformio-wsl.sh",
    "firmware:build:diagnostic": "node scripts/pio-local.mjs run -d firmware -e atoms3lite_diagnostic",
    "firmware:build:runtime-check": "node scripts/pio-local.mjs run -d firmware -e atoms3lite_runtime_check",
    "firmware:build:runtime": "node scripts/pio-local.mjs run -d firmware -e atoms3lite_runtime",
    "firmware:upload:diagnostic": "node scripts/pio-local.mjs run -d firmware -e atoms3lite_diagnostic -t upload",
    "firmware:upload:runtime": "node scripts/pio-local.mjs run -d firmware -e atoms3lite_runtime -t upload",
    "firmware:devices": "node scripts/pio-local.mjs device list",
    "firmware:monitor": "node scripts/pio-local.mjs device monitor -b 115200"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
